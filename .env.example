# Copy to .env and fill in. .env is gitignored — this repo is public and holds no secrets.
# Every value here is a resource identifier, not a credential. Auth is Entra:
# device code locally, GitHub OIDC federated credentials in CI.

# --- Azure control plane: where Foundry lives ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=

# --- Azure AI Foundry ---
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
FOUNDRY_PROJECT_ENDPOINT=

# --- Model deployments (pinned; see config/settings.yaml for versions and why) ---
MODEL_INGEST=
MODEL_STRONG=

# --- Microsoft Graph: where the demo mailbox lives ---
# Deliberately separate from AZURE_TENANT_ID. The Foundry subscription's directory has
# no Exchange, so the M365 demo tenant is a different tenant with its own app
# registration. Two tenants means two credential chains. See docs/decisions.md D-002.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_MAILBOX=

# --- GitHub ---
GITHUB_REPO=hkaanturgut/chief-of-staff-agents
