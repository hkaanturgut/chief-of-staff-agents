{
  "$defs": {
    "Signal": {
      "additionalProperties": false,
      "description": "One extracted observation from one source.",
      "properties": {
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "counterparty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counterparty"
        },
        "due": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "type": {
          "enum": [
            "ask",
            "commitment",
            "fyi",
            "deadline",
            "meeting_prep",
            "conflict"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "statement",
        "sources"
      ],
      "title": "Signal",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "The unit of provenance. Nothing enters the pipeline without one.",
      "properties": {
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "author_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author Address"
        },
        "excerpt": {
          "default": "",
          "maxLength": 240,
          "title": "Excerpt",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mail",
            "chat",
            "calendar"
          ],
          "title": "Kind",
          "type": "string"
        },
        "permalink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Permalink"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "timestamp"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What an ingest agent returns. Extraction only \u2014 no ranking, no drafting.",
  "properties": {
    "signals": {
      "items": {
        "$ref": "#/$defs/Signal"
      },
      "title": "Signals",
      "type": "array"
    }
  },
  "title": "SignalExtraction",
  "type": "object"
}
